+// GPU timing (NSMBW_GPU_TIMING)
+
+namespace {
+bool HasListToken(std::string_view list, std::string_view name);
+}  // namespace
+
+// static
+const Device::GpuOptions& Device::GetGpuOptions() {
+    static const GpuOptions options = [] {
+        const char* env = std::getenv("NSMBW_GPU_TIMING");
+        const std::string_view list = env != nullptr ? env : "";
+        GpuOptions o;
+        o.timing = HasListToken(list, "1");
+        o.aniso1 = HasListToken(list, "aniso1");
+        o.gpuCopy = HasListToken(list, "gpucopy");
+        o.passBarrier = HasListToken(list, "passbarrier");
+        std::fprintf(stderr,
+                     "[gpu-timing] options \"%s\": timing=%d aniso1=%d gpucopy=%d passbarrier=%d\n",
+                     env != nullptr ? env : "", int(o.timing), int(o.aniso1), int(o.gpuCopy),
+                     int(o.passBarrier));
+        return o;
+    }();
+    return options;
+}
+
+// static
+Device::TimingTag Device::TagForPassLabel(const std::string& label, uint8_t* gxIndex) {
+    *gxIndex = 0xFF;
+    std::string_view l = label;
+    constexpr std::string_view kGx = "Render pass";
+    if (l.substr(0, kGx.size()) == kGx) {
+        std::string_view rest = l.substr(kGx.size());
+        while (!rest.empty() && rest.front() == ' ') rest.remove_prefix(1);
+        uint32_t index = 0;
+        bool digits = false;
+        while (!rest.empty() && rest.front() >= '0' && rest.front() <= '9') {
+            index = index * 10 + uint32_t(rest.front() - '0');
+            rest.remove_prefix(1);
+            digits = true;
+        }
+        *gxIndex = digits ? uint8_t(std::min<uint32_t>(index, kTimingGxSlots - 1))
+                          : uint8_t(kTimingGxSlots - 1);
+        return TimingTag::GxPass;
+    }
+    if (l.find("TexCopyConv") != std::string_view::npos) return TimingTag::ConvPass;
+    if (l.find("TexPaletteConv") != std::string_view::npos) return TimingTag::PalettePass;
+    if (l.find("snapshot pass") != std::string_view::npos) return TimingTag::SnapshotPass;
+    if (l.find("ImGui") != std::string_view::npos) return TimingTag::ImGuiPass;
+    if (l.find("Presentation copy") != std::string_view::npos) return TimingTag::PresentPass;
+    return TimingTag::OtherPass;
+}
+
+void Device::TimingMark(DkCmdBuf cmdBuf, TimingTag tag, uint8_t index) {
+    if (!GetGpuOptions().timing) {
+        return;
+    }
+    if (mTimingPending.block == nullptr) {
+        if (!mTimingFreeBlocks.empty()) {
+            mTimingPending.block = mTimingFreeBlocks.back();
+            mTimingFreeBlocks.pop_back();
+        } else {
+            DkMemBlockMaker maker;
+            dkMemBlockMakerDefaults(&maker, mDkDevice,
+                                    AlignUp(kTimingMarksPerSubmit * 16, DK_MEMBLOCK_ALIGNMENT));
+            maker.flags = DkMemBlockFlags_CpuUncached | DkMemBlockFlags_GpuCached;
+            mTimingPending.block = dkMemBlockCreate(&maker);
+            if (mTimingPending.block == nullptr) {
+                mTimingWindow.droppedMarks++;
+                return;
+            }
+        }
+        mTimingPending.marks.clear();
+    }
+    if (mTimingPending.marks.size() >= kTimingMarksPerSubmit) {
+        mTimingWindow.droppedMarks++;
+        return;
+    }
+    const DkGpuAddr addr =
+        dkMemBlockGetGpuAddr(mTimingPending.block) + mTimingPending.marks.size() * 16;
+    dkCmdBufReportCounter(cmdBuf, DkCounter_Timestamp, addr);
+    mTimingPending.marks.emplace_back(uint8_t(tag), index);
+}
+
+void Device::TimingOnPresent() {
+    if (GetGpuOptions().timing) {
+        mTimingWindow.presents++;
+    }
+}
+
+void Device::TimingCountSampler(bool anisotropic) {
+    mSamplersCreated++;
+    if (anisotropic) {
+        mSamplersAnisotropic++;
+    }
+}
+
+void Device::TimingProcess(const TimingBlock& timing) {
+    const size_t count = timing.marks.size();
+    if (timing.block == nullptr || count < 2) {
+        return;
+    }
+    // A DkCounter_Timestamp report is {counter value, timestamp}, 8 bytes each.
+    const uint64_t* reports = static_cast<const uint64_t*>(dkMemBlockGetCpuAddr(timing.block));
+    auto ts = [&](size_t i) { return reports[i * 2 + 1]; };
+    TimingWindow& w = mTimingWindow;
+    const uint64_t first = ts(0);
+    if (w.firstTicks == 0) {
+        w.firstTicks = first;
+    }
+    if (mTimingLastEndTicks != 0 && first > mTimingLastEndTicks) {
+        w.idleTicks += first - mTimingLastEndTicks;
+    }
+    uint64_t prev = first;
+    for (size_t i = 1; i < count; ++i) {
+        const uint64_t t = std::max(ts(i), prev);
+        const uint64_t d = t - prev;
+        prev = t;
+        const auto [tag, index] = timing.marks[i];
+        w.tagTicks[tag < size_t(TimingTag::Count) ? tag : size_t(TimingTag::Other)] += d;
+        if (tag == uint8_t(TimingTag::GxPass) && index < kTimingGxSlots) {
+            w.gxTicks[index] += d;
+            w.gxCount[index]++;
+        }
+    }
+    w.busyTicks += prev - first;
+    w.marks += count;
+    w.submits++;
+    mTimingLastEndTicks = prev;
+    if (mTimingWindows == 0 && w.submits == 1) {
+        std::fprintf(stderr,
+                     "[gpu-timing] first report raw: value=%llu ts=%llu, now=%llu, %zu marks\n",
+                     (unsigned long long)reports[0], (unsigned long long)first,
+                     (unsigned long long)dkDeviceGetCurrentTimestamp(mDkDevice), count);
+    }
+    if (w.presents >= 300) {
+        TimingReport(prev);
+    }
+}
+
+void Device::TimingReport(uint64_t lastTicks) {
+    TimingWindow& w = mTimingWindow;
+    const double frames = double(std::max<uint64_t>(w.presents, 1));
+    auto ms = [&](uint64_t ticks) { return double(dkTimestampToNs(ticks)) / 1e6 / frames; };
+    const double wallMs = double(dkTimestampToNs(lastTicks - w.firstTicks)) / 1e6;
+    const double cpuTicksToMs = 1000.0 / double(armGetSystemTickFreq());
+    static const char* const kNames[] = {"start", "other", "gx",   "conv",  "pal",  "snap",   "imgui",
+                                         "pres",  "opass", "bcopy", "tupl", "t2t", "t2b"};
+    char tags[512];
+    int n = 0;
+    for (size_t i = 1; i < size_t(TimingTag::Count); ++i) {
+        n += std::snprintf(tags + n, sizeof(tags) - n, " %s=%.2f", kNames[i], ms(w.tagTicks[i]));
+    }
+    // The three most expensive GX passes by index (per frame they run in).
+    char gx[256];
+    int g = 0;
+    bool used[kTimingGxSlots] = {};
+    for (int k = 0; k < 4; ++k) {
+        int best = -1;
+        for (uint32_t i = 0; i < kTimingGxSlots; ++i) {
+            if (!used[i] && w.gxCount[i] != 0 && (best < 0 || w.gxTicks[i] > w.gxTicks[best])) {
+                best = int(i);
+            }
+        }
+        if (best < 0) break;
+        used[best] = true;
+        g += std::snprintf(gx + g, sizeof(gx) - g, " p%d=%.2fms/%.2f", best, ms(w.gxTicks[best]),
+                           double(w.gxCount[best]) / frames);
+    }
+    gx[g] = '\0';
+    std::fprintf(stderr,
+                 "[gpu-timing] w%llu frames=%llu wall=%.0fms interval=%.2fms busy=%.2f idle=%.2f "
+                 "submits=%.2f passes=%.2f draws=%.1f |%s | gxtop%s | cpu_upload=%.2fms %.0fKB "
+                 "waits=%llu %.2fms gpucopy=%.2f %.0fKB marks=%.0f dropped=%llu samplers=%llu/%llu aniso\n",
+                 (unsigned long long)mTimingWindows, (unsigned long long)w.presents, wallMs,
+                 wallMs / frames, ms(w.busyTicks), ms(w.idleTicks), double(w.submits) / frames,
+                 double(w.passes) / frames, double(w.draws) / frames, tags, gx,
+                 double(w.cpuUploadTicks) * cpuTicksToMs / frames,
+                 double(w.cpuUploadBytes) / 1024.0 / frames, (unsigned long long)w.cpuWaits,
+                 double(w.cpuWaitTicks) * cpuTicksToMs / frames, double(w.gpuCopies) / frames,
+                 double(w.gpuCopyBytes) / 1024.0 / frames, double(w.marks) / frames,
+                 (unsigned long long)w.droppedMarks, (unsigned long long)mSamplersAnisotropic.load(),
+                 (unsigned long long)mSamplersCreated.load());
+    ++mTimingWindows;
+    w = TimingWindow{};
+}
