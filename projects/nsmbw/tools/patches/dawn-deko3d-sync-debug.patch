+namespace {
+// Synchronisation diagnosis, set through AURORA_GFX_FLAGS (sdmc:/switch/nsmbw/gfx_flags.txt):
+//   dk_copybarrier  full barrier with cache invalidation before and after every copy-engine command
+//   dk_inlinewrites buffer writes never use the copy engine, always the 3D engine's inline data
+//   dk_flushcopies  submit and wait for the GPU before and after every copy-engine command
+//   dk_waitsubmit   wait for the GPU after every queue submit
+struct SyncDebug {
+    bool copyBarrier = false;
+    bool inlineWrites = false;
+    bool flushCopies = false;
+    bool waitSubmit = false;
+};
+
+bool HasGfxFlag(std::string_view list, std::string_view name) {
+    while (!list.empty()) {
+        const size_t comma = list.find(',');
+        std::string_view item = list.substr(0, comma);
+        while (!item.empty() && item.front() == ' ') item.remove_prefix(1);
+        while (!item.empty() && item.back() == ' ') item.remove_suffix(1);
+        if (item == name) {
+            return true;
+        }
+        list = comma == std::string_view::npos ? std::string_view{} : list.substr(comma + 1);
+    }
+    return false;
+}
+
+const SyncDebug& GetSyncDebug() {
+    static const SyncDebug flags = [] {
+        const char* env = std::getenv("AURORA_GFX_FLAGS");
+        const std::string_view list = env != nullptr ? env : "";
+        SyncDebug f;
+        f.copyBarrier = HasGfxFlag(list, "dk_copybarrier");
+        f.inlineWrites = HasGfxFlag(list, "dk_inlinewrites");
+        f.flushCopies = HasGfxFlag(list, "dk_flushcopies");
+        f.waitSubmit = HasGfxFlag(list, "dk_waitsubmit");
+        std::fprintf(stderr,
+                     "[deko3d] sync debug: copybarrier=%d inlinewrites=%d flushcopies=%d "
+                     "waitsubmit=%d\n",
+                     int(f.copyBarrier), int(f.inlineWrites), int(f.flushCopies),
+                     int(f.waitSubmit));
+        return f;
+    }();
+    return flags;
+}
+
+constexpr uint32_t kCopyInvalidateFlags = DkInvalidateFlags_Image | DkInvalidateFlags_Shader |
+                                          DkInvalidateFlags_Descriptors |
+                                          DkInvalidateFlags_L2Cache;
+}  // namespace
