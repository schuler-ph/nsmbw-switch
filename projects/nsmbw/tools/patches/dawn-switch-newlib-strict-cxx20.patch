diff --git a/src/dawn/native/utils/WGPUHelpers.cpp b/src/dawn/native/utils/WGPUHelpers.cpp
index c8dde717cc..7d90e1bcac 100644
--- a/src/dawn/native/utils/WGPUHelpers.cpp
+++ b/src/dawn/native/utils/WGPUHelpers.cpp
@@ -236,7 +236,17 @@ std::string_view NormalizeMessageString(StringView in) {
     if (in.IsUndefined()) {
         return {};
     }
+#if defined(__SWITCH__)
+    // strnlen() is hidden by strict C++20 in newlib. Stop at the first NUL
+    // or the explicit bound; WGPU_STRLEN also works for terminated strings.
+    size_t length = 0;
+    while (length < in.length && DAWN_UNSAFE_TODO(in.data[length]) != '\0') {
+        ++length;
+    }
+    return std::string_view(in.data, length);
+#else
     return std::string_view(in.data, DAWN_UNSAFE_TODO(strnlen(in.data, in.length)));
+#endif
 }
 
 }  // namespace dawn::native::utils
